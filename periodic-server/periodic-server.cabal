name:                periodic-server
version:             1.2.9.2
synopsis:            Periodic task system haskell server
description:         Periodic task system haskell server and command peridoicd.
homepage:            https://github.com/Lupino/haskell-periodic/tree/master/periodic-server#readme
license:             BSD3
license-file:        LICENSE
author:              Li Meng Jun
maintainer:          lmjubuntu@gmail.com
copyright:           MIT
category:            System,Web
build-type:          Simple
extra-source-files:  README.md
cabal-version:       >=1.10

library
  hs-source-dirs:      src
  exposed-modules:     Periodic.Server.Scheduler
                     , Periodic.Server.SchedPool
                     , Periodic.Server.GrabQueue
                     , Periodic.Server.FuncStat
                     , Periodic.Server.Persist
                     , Periodic.Server.Persist.SQLite
                     , Periodic.Server.Persist.Workload
                     , Periodic.Server.Persist.Memory
                     , Periodic.Server.Persist.Cache
                     , Periodic.Server.Auth
                     , Periodic.Server.Client
                     , Periodic.Server.Types
                     , Periodic.Server.Hook
                     , Periodic.Server
  build-depends:       base >= 4.7 && < 5
                     , periodic-common
                     , bytestring
                     , containers
                     , directory
                     , filepath
                     , hslogger
                     , byteable
                     , binary
                     , transformers
                     , mtl

                     , direct-sqlite
                     , unliftio
                     , metro
                     , map-io
                     , entropy

                     , base64-bytestring
                     , crypton

                     , metro-socket
                     , unix-time

  if !os(windows)
    exposed-modules:   Periodic.Server.Persist.PSQL
    build-depends:     psql-utils

  default-language:    Haskell2010

executable periodicd
  hs-source-dirs:      app
  main-is:             periodicd.hs
  ghc-options:         -threaded -rtsopts -with-rtsopts=-N
  build-depends:       base
                     , periodic-server
                     , hslogger
                     , metro
                     , metro-socket
                     , metro-transport-crypto
  other-modules:       Paths_periodic_server
  default-language:    Haskell2010

test-suite workload
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Workload.hs
  build-depends:       base
                     , bytestring
                     , directory
                     , filepath
                     , periodic-common
                     , periodic-server
  default-language:    Haskell2010

test-suite sched-pool
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             SchedPool.hs
  build-depends:       base
                     , periodic-common
                     , periodic-server
                     , unliftio
  default-language:    Haskell2010

source-repository head
  type:     git
  location: https://github.com/Lupino/haskell-periodic
